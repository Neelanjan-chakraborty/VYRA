# Copy to .env.local for development. None of these are secrets, but real values
# belong in the host's environment settings, not in the repository.

# Canonical production origin: scheme + host, no path, no trailing slash.
# Canonical URLs, Open Graph URLs, the sitemap and robots.txt are all derived from it. There
# is no default domain in the code. Until it is set, even a production deployment is served
# as a non-indexable preview (noindex, robots.txt disallows all, empty sitemap).
NEXT_PUBLIC_SITE_URL=

# production | preview | development. Only "production" is indexable; everything else
# serves "noindex" and a robots.txt that disallows all crawling. If unset, the host's
# VERCEL_ENV or Netlify CONTEXT is used, and failing that the site is a non-indexable preview.
VYRA_SITE_ENV=

# Where "Enter VYRA" goes once the app is publicly available (store page or web app).
# While empty, the button leads to the availability note on /how-it-works.
NEXT_PUBLIC_APP_URL=

# Published on /contact only when set. While empty the page says so and is not indexed.
NEXT_PUBLIC_CONTACT_EMAIL=

# draft | published. Set "published" only after counsel-reviewed documents replace the
# drafts in src/app/privacy and src/app/terms. Drafts are noindex and outside the sitemap.
VYRA_LEGAL_STATUS=draft

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Nothing loads without visitor consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML-tag verification token (the content value only).
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools meta-tag verification token (the content value only).
BING_SITE_VERIFICATION=

# IndexNow key (8-128 letters, digits or dashes; generate one at bing.com/indexnow). Served at
# /indexnow-key.txt and used by `pnpm --filter @vyra/landing indexnow` after a deploy.
INDEXNOW_KEY=

# allow | disallow. Crawlers that collect text to TRAIN AI models: GPTBot, ClaudeBot,
# Google-Extended, CCBot. Search and answer crawlers (OAI-SearchBot, PerplexityBot,
# Claude-SearchBot, Googlebot, Bingbot) are always allowed and are not affected.
# Left empty, no decision is recorded and these crawlers fall under the general "allow" rule.
# This is a product-owner decision: see docs/seo/geo-implementation.md, "Training crawlers".
VYRA_AI_TRAINING_CRAWLERS=

# Verified official profiles only (LinkedIn, Instagram, X...), comma-separated absolute URLs.
# They become `sameAs` on the Organization structured data. Leave empty until they exist.
NEXT_PUBLIC_SAME_AS=
