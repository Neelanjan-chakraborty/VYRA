{
  "expo": {
    "name": "VYRA",
    "slug": "vyra",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vyra",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#100F13",
    "ios": {
      "bundleIdentifier": "app.vyra.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "app.vyra.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#100F13",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#100F13",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
