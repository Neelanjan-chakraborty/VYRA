{
  "expo": {
    "name": "VYRA",
    "slug": "vyra",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vyra",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#100F13",
    "ios": {
      "bundleIdentifier": "app.vyra.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationDefaultAccuracyReduced": true
      }
    },
    "android": {
      "package": "app.vyra.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#100F13",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#100F13",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VYRA uses your approximate location to show roughly how far away people are. You can choose a city instead.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "VYRA uses the microphone only while you hold to record a voice note for a connection.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#A77AE8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
