{
  "name": "vyra",
  "version": "0.1.0",
  "private": true,
  "description": "VYRA \u2014 Chemistry, decoded. AI-native relationship discovery platform.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev:api": "pnpm --filter @vyra/api dev",
    "dev:mobile": "pnpm --filter @vyra/mobile start",
    "db:migrate": "pnpm --filter @vyra/api db:migrate",
    "db:deploy": "pnpm --filter @vyra/api db:deploy",
    "db:generate": "pnpm --filter @vyra/api db:generate",
    "services:start": "bash scripts/dev-services.sh",
    "e2e:web": "node scripts/e2e-web.cjs",
    "engine:catalogue": "node scripts/engine-catalogue.mjs",
    "engine:fixtures": "node scripts/engine-fixtures.mjs",
    "rust:check": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace"
  },
  "devDependencies": {
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "~6.0.3"
  }
}
