# Copy to apps/api/.env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://vyra:vyra@localhost:5432/vyra_dev
REDIS_URL=redis://localhost:6379
# mock | openai | gemini — "mock" is deterministic and needs no credentials.
AI_PROVIDER=mock
# Comma-separated list of allowed browser origins (admin, Expo web).
CORS_ORIGINS=http://localhost:8081
LOG_LEVEL=log

# Secrets below are local-development values. Generate real ones per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-jwt-secret-change-me-0000000000000000
OTP_PEPPER=dev-only-otp-pepper-change-me-00000000000000000
MEDIA_URL_SECRET=dev-only-media-secret-change-me-000000000000000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# dev = no message is sent; the code is returned in the API response. Refused in production.
OTP_DELIVERY=dev
# local = files on this machine's disk. Refused in production.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
PUBLIC_API_URL=http://localhost:4000
