# Copy to apps/api/.env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://vyra:vyra@localhost:5432/vyra_dev
REDIS_URL=redis://localhost:6379
# mock | openai | gemini — "mock" is deterministic and needs no credentials.
AI_PROVIDER=mock
# Comma-separated list of allowed browser origins (admin, Expo web).
CORS_ORIGINS=http://localhost:8081
LOG_LEVEL=log
